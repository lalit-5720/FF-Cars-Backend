datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum CarStatus {
  AVAILABLE
  BOOKED
  MAINTENANCE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  password      String
  name          String
  role          Role           @default(CUSTOMER)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  bookings      Booking[]
  wishlists     Wishlist[]
  notifications Notification[]

  @@map("users")
}

model Car {
  id           String     @id @default(uuid())
  brand        String
  model        String
  variant      String
  year         Int
  fuelType     String     @map("fuel_type")
  transmission String
  kmDriven     Int        @map("km_driven")
  ownership    String
  price        Float
  description  String     @db.Text
  status       CarStatus  @default(AVAILABLE)
  thumbnail    String
  images       Json       // JSON Array of Image URLs from Cloudinary or local paths
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  bookings     Booking[]
  wishlists    Wishlist[]

  @@index([brand, model])
  @@index([price])
  @@map("cars")
}

model Booking {
  id            String        @id @default(uuid())
  userId        String        @map("user_id")
  carId         String        @map("car_id")
  bookingStatus BookingStatus @default(PENDING) @map("booking_status")
  paymentStatus PaymentStatus @default(PENDING) @map("payment_status")
  bookingAmount Float         @map("booking_amount")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  car  Car  @relation(fields: [carId], references: [id], onDelete: Cascade)

  @@map("bookings")
}

model Wishlist {
  id     String @id @default(uuid())
  userId String @map("user_id")
  carId  String @map("car_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  car  Car  @relation(fields: [carId], references: [id], onDelete: Cascade)

  @@unique([userId, carId])
  @@map("wishlists")
}

model Notification {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  message    String   @db.Text
  readStatus Boolean  @default(false) @map("read_status")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}
