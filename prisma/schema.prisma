generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model branches {
  branch_id    Int         @id @default(autoincrement())
  branch_name  String      @db.VarChar(100)
  manager_name String?     @db.VarChar(100)
  phone        String?     @db.VarChar(15)
  email        String?     @db.VarChar(100)
  address      String?
  city         String?     @db.VarChar(50)
  state        String?     @db.VarChar(50)
  pincode      String?     @db.VarChar(10)
  opening_date DateTime?   @db.Date
  status       String?     @default("Active") @db.VarChar(20)
  created_at   DateTime?   @default(now()) @db.Timestamp(6)
  employees    employees[]
  sales        sales[]
  vehicles     vehicles[]
}

model customers {
  customer_id       Int           @id @default(autoincrement())
  first_name        String        @db.VarChar(50)
  last_name         String?       @db.VarChar(50)
  phone             String?       @unique @db.VarChar(15)
  email             String?       @db.VarChar(100)
  password          String?       @db.VarChar(255)
  gender            String?       @db.VarChar(10)
  date_of_birth     DateTime?     @db.Date
  occupation        String?       @db.VarChar(100)
  city              String?       @db.VarChar(50)
  state             String?       @db.VarChar(50)
  address           String?
  pincode           String?       @db.VarChar(10)
  preferred_contact String?       @db.VarChar(20)
  created_at        DateTime?     @default(now()) @db.Timestamp(6)
  leads             leads[]
  sales             sales[]
  test_drives       test_drives[]
  reviews           reviews[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model deliveries {
  delivery_id       Int        @id @default(autoincrement())
  sale_id           Int
  delivery_date     DateTime?  @db.Date
  delivered_by      Int?
  customer_received Boolean?   @default(false)
  odometer_reading  Int?
  delivery_notes    String?
  delivery_status   String?    @db.VarChar(20)
  created_at        DateTime?  @default(now()) @db.Timestamp(6)
  employees         employees? @relation(fields: [delivered_by], references: [employee_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_delivery_employee")
  sales             sales      @relation(fields: [sale_id], references: [sale_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_delivery_sale")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model employees {
  employee_id   Int           @id @default(autoincrement())
  branch_id     Int
  first_name    String        @db.VarChar(50)
  last_name     String?       @db.VarChar(50)
  gender        String?       @db.VarChar(10)
  date_of_birth DateTime?     @db.Date
  phone         String?       @db.VarChar(15)
  email         String?       @db.VarChar(100)
  password      String?       @db.VarChar(255)
  role          String?       @db.VarChar(50)
  hire_date     DateTime?     @db.Date
  salary        Decimal?      @db.Decimal(12, 2)
  status        String?       @default("Active") @db.VarChar(20)
  created_at    DateTime?     @default(now()) @db.Timestamp(6)
  deliveries    deliveries[]
  branches      branches      @relation(fields: [branch_id], references: [branch_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_employee_branch")
  leads         leads[]
  sales         sales[]
  test_drives   test_drives[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model leads {
  lead_id        Int       @id @default(autoincrement())
  customer_id    Int
  vehicle_id     Int
  employee_id    Int
  source         String?   @db.VarChar(50)
  inquiry_date   DateTime? @db.Date
  interest_level String?   @db.VarChar(20)
  status         String?   @default("New") @db.VarChar(20)
  remarks        String?
  created_at     DateTime? @default(now()) @db.Timestamp(6)
  customers      customers @relation(fields: [customer_id], references: [customer_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_lead_customer")
  employees      employees @relation(fields: [employee_id], references: [employee_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_lead_employee")
  vehicles       vehicles  @relation(fields: [vehicle_id], references: [vehicle_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_lead_vehicle")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model payments {
  payment_id            Int       @id @default(autoincrement())
  sale_id               Int
  payment_date          DateTime? @db.Date
  payment_method        String?   @db.VarChar(30)
  transaction_reference String?   @db.VarChar(100)
  amount_paid           Decimal?  @db.Decimal(12, 2)
  payment_status        String?   @db.VarChar(20)
  remarks               String?
  created_at            DateTime? @default(now()) @db.Timestamp(6)
  sales                 sales     @relation(fields: [sale_id], references: [sale_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_payment_sale")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model sales {
  sale_id         Int          @id @default(autoincrement())
  customer_id     Int
  vehicle_id      Int
  employee_id     Int
  branch_id       Int
  sale_date       DateTime?    @db.Date
  selling_price   Decimal?     @db.Decimal(12, 2)
  discount        Decimal?     @default(0) @db.Decimal(12, 2)
  tax             Decimal?     @default(0) @db.Decimal(12, 2)
  final_amount    Decimal?     @db.Decimal(12, 2)
  payment_status  String?      @db.VarChar(20)
  delivery_status String?      @db.VarChar(20)
  remarks         String?
  created_at      DateTime?    @default(now()) @db.Timestamp(6)
  deliveries      deliveries[]
  payments        payments[]
  branches        branches     @relation(fields: [branch_id], references: [branch_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_sale_branch")
  customers       customers    @relation(fields: [customer_id], references: [customer_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_sale_customer")
  employees       employees    @relation(fields: [employee_id], references: [employee_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_sale_employee")
  vehicles        vehicles     @relation(fields: [vehicle_id], references: [vehicle_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_sale_vehicle")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model test_drives {
  test_drive_id   Int       @id @default(autoincrement())
  customer_id     Int
  vehicle_id      Int
  employee_id     Int
  test_drive_date DateTime? @db.Date
  start_time      DateTime? @db.Time(6)
  end_time        DateTime? @db.Time(6)
  status          String?   @default("Scheduled") @db.VarChar(20)
  feedback        String?
  rating          Int?
  created_at      DateTime? @default(now()) @db.Timestamp(6)
  customers       customers @relation(fields: [customer_id], references: [customer_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_td_customer")
  employees       employees @relation(fields: [employee_id], references: [employee_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_td_employee")
  vehicles        vehicles  @relation(fields: [vehicle_id], references: [vehicle_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_td_vehicle")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model vehicles {
  vehicle_id           Int           @id @default(autoincrement())
  branch_id            Int
  make                 String        @db.VarChar(50)
  model                String        @db.VarChar(50)
  manufacture_year     Int?
  registration_number  String?       @unique @db.VarChar(20)
  fuel_type            String?       @db.VarChar(20)
  transmission         String?       @db.VarChar(20)
  owner_type           String?       @db.VarChar(30)
  kilometers_driven    Int?
  color                String?       @db.VarChar(30)
  insurance_valid_till DateTime?     @db.Date
  purchase_price       Decimal?      @db.Decimal(12, 2)
  purchase_date        DateTime?     @db.Date
  price                Decimal?      @db.Decimal(12, 2)
  status               String?       @default("Available") @db.VarChar(20)
  description          String?
  image_url            String?
  created_at           DateTime?     @default(now()) @db.Timestamp(6)
  leads                leads[]
  sales                sales[]
  test_drives          test_drives[]
  reviews              reviews[]
  branches             branches      @relation(fields: [branch_id], references: [branch_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_vehicle_branch")
}

model reviews {
  review_id    Int       @id @default(autoincrement())
  customer_id  Int
  vehicle_id   Int
  rating       Int       @default(5)
  comment      String
  is_published Boolean   @default(false)
  created_at   DateTime? @default(now()) @db.Timestamp(6)
  customers    customers @relation(fields: [customer_id], references: [customer_id], onDelete: Cascade, map: "fk_review_customer")
  vehicles     vehicles  @relation(fields: [vehicle_id], references: [vehicle_id], onDelete: Cascade, map: "fk_review_vehicle")
}
